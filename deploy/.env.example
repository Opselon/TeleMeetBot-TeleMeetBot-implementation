# ==============================================================================
# TeleMeetBot — Environment Configuration
# Copy this file to .env and customize for your deployment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Credentials (Required)
# ------------------------------------------------------------------------------
# Obtain from @BotFather on Telegram
TELEGRAM_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE

# Comma-separated Telegram User IDs permitted as admins (run /id in bot to check)
# If empty, the first user to send /start claims admin rights automatically.
TELEGRAM_ADMINS=

# Optional notification destination Telegram Chat/User ID
TELEGRAM_NOTIFY_CHAT_ID=

# ------------------------------------------------------------------------------
# 2. Telegram Local Bot API (2.0 GiB / 2000 MiB Media Support)
# ------------------------------------------------------------------------------
# Telegram API credentials from https://my.telegram.org (App Configuration)
TELEGRAM_API_ID=17349
TELEGRAM_API_HASH=344583e45741c457fe1862106095a5eb

# Automatically supervizes embedded telegram-bot-api in --local mode
TELEGRAM_LOCAL_BOT_API_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 / OpenID Connect (Optional)
# ------------------------------------------------------------------------------
# Web Application credentials from Google Cloud Console
# Redirect URI: https://<your-domain>/auth/google/callback
TELEMEETBOT_GOOGLE_CLIENT_ID=
TELEMEETBOT_GOOGLE_CLIENT_SECRET=
TELEMEETBOT_GOOGLE_REDIRECT_URL=

# ------------------------------------------------------------------------------
# 4. Networking & Egress Proxy (Optional)
# ------------------------------------------------------------------------------
# Outbound proxy for YouTube egress & media fetching (http://, socks5://)
# TELEMEETBOT_PROXY=http://172.17.0.1:3339

# ------------------------------------------------------------------------------
# 5. Docker Deployment Options
# ------------------------------------------------------------------------------
TELEMEETBOT_IMAGE=ghcr.io/opselon/telemeetbot-telemeetbot-implementation:latest
DATA_DIR=./data
HEALTH_PORT=18080
