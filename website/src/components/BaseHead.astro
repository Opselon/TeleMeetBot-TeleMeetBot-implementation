---
import { absolute, url } from '../utils/paths';

type Props = {
  title: string;
  description: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  image?: string;
};

const { title, description, noindex = false, type = 'website', jsonLd = [], image = '/og.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://opselon.github.io').href;
const socialImage = absolute(image);
const fullTitle = title.includes('TeleMeetBot') ? title : `${title} · TeleMeetBot`;
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'TeleMeetBot',
    url: absolute('/'),
    description: 'Documentation for TeleMeetBot, a headless Google Meet streaming bot with a Telegram dashboard.',
  },
  ...jsonLd,
];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
<link rel="manifest" href={url('/site.webmanifest')} />
<meta name="theme-color" content="#06090f" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f7f9fc" media="(prefers-color-scheme: light)" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="TeleMeetBot" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="TeleMeetBot — headless Google Meet streaming, driven from Telegram" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="sitemap" href={url('/sitemap.xml')} />
<link rel="alternate" type="application/json" title="TeleMeetBot search index" href={url('/search.json')} />

<script is:inline>
  (() => {
    const key = 'tmb-theme';
    let theme = null;
    try {
      theme = localStorage.getItem(key);
    } catch {}
    if (theme !== 'light' && theme !== 'dark') {
      theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    document.documentElement.dataset.theme = theme;
  })();
</script>

{schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
