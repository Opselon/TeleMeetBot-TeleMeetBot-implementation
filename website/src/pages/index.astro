---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import repo from '../data/repo.generated.json';
import { site } from '../data/site';
import { url } from '../utils/paths';

const latest = repo.github.releases.find((release) => !release.draft && !release.prerelease) ?? repo.github.releases[0];
const releaseUrl = latest?.url ?? `${repo.repoUrl}/releases`;
const version = latest?.tag ?? repo.version;
const unitTests = repo.testTotals.unit;
const integrationTests = repo.testTotals.integration;
const archs = repo.releaseTargets.map((target) => target.split('/').slice(1).join(''));
const flags = repo.unwiredConfig.slice(0, 8);
const states = repo.states;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'TeleMeetBot',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Linux',
    description: site.description,
    url: 'https://opselon.github.io/TeleMeetBot-TeleMeetBot-implementation/',
    codeRepository: repo.repoUrl,
    license: 'https://opensource.org/licenses/MIT',
    programmingLanguage: 'Go',
    softwareVersion: version,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    keywords: 'Google Meet, Telegram bot, headless Chromium, screen sharing, streaming, Go',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Does TeleMeetBot need a desktop or a virtual display?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. In tab mode the bot runs Chromium headless and shares the internal media tab. Screen mode is optional and needs Xvfb.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can the bot join any Google Meet?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'It joins as a guest. Meetings that require a Google sign-in cannot be joined, and host-restricted meetings need a host to admit the bot.',
        },
      },
      {
        '@type': 'Question',
        name: 'Which links can be presented?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'YouTube watch, shorts and live links, direct media files with a supported extension, and generic web pages rendered in the embedded player.',
        },
      },
    ],
  },
];

const features = [
  {
    icon: 'monitor',
    title: 'Headless tab capture',
    body: 'Chromium runs without a desktop. The bot shares a real tab through Meet’s Present flow, with the capture source matched by title.',
    href: '/docs/google-meet/',
    link: 'How sharing works',
  },
  {
    icon: 'message',
    title: 'Telegram dashboard',
    body: 'Sessions, settings, health and live cards refresh every three seconds. Every control is an inline button — no web panel to secure.',
    href: '/docs/telegram/',
    link: 'Commands and cards',
  },
  {
    icon: 'play',
    title: 'Playback control',
    body: 'Pause, resume, mute, volume, seek, restart and stop. The player is a local page, so controls do not depend on the source site’s UI.',
    href: '/docs/playback/',
    link: 'Playback guide',
  },
  {
    icon: 'activity',
    title: 'Real diagnostics',
    body: 'A doctor checks config, Chromium, disk, port, token and network. A capture self-test proves video frames change and audio exists.',
    href: '/docs/diagnostics/',
    link: 'Diagnostics',
  },
  {
    icon: 'shield',
    title: 'Fail-closed access',
    body: 'A numeric allow-list gates every Telegram update. The only HTTP surface is read-only health; there are no remote control endpoints.',
    href: '/docs/security/',
    link: 'Security model',
  },
  {
    icon: 'layers',
    title: 'Boring to operate',
    body: 'One static Go binary, a Dockerfile with healthchecks, a systemd unit, an installer and cross-arch archives with checksums.',
    href: '/docs/deployment/',
    link: 'Deployment',
  },
];
---
<BaseLayout title="TeleMeetBot — headless Google Meet streaming from Telegram" description={site.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-aurora" aria-hidden="true"><span class="bolt"></span></div>
    <div class="wrap hero-inner">
      <div data-animate="hero">
        <span class="eyebrow">
          <Icon name="spark" size={13} />
          {version} · Go {repo.goVersion} · MIT
        </span>
        <h1>Send a link.<br />Your meeting <span class="accent">watches it</span>.</h1>
        <p class="hero-sub">
          TeleMeetBot joins a Google Meet as a guest, presents a tab and plays whatever you send it —
          YouTube, a direct media file or any web page. You steer playback from Telegram.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={url('/docs/getting-started/')}>
            Get started
            <Icon name="arrowRight" size={16} />
          </a>
          <a class="btn btn-ghost" href={url('/demo/')}>
            <Icon name="play" size={16} />
            Try live demo
          </a>
          <a class="btn btn-ghost" href={repo.repoUrl} rel="noopener">
            <Icon name="github" size={16} />
            Source
          </a>
        </div>
        <ul class="hero-meta">
          <li>100% Go · one binary</li>
          <li>No desktop, no Xvfb</li>
          <li>{archs.length} architectures</li>
          <li>{unitTests} unit tests</li>
        </ul>
      </div>

      <div class="code-panel" aria-label="Quick start commands" data-animate="hero-panel">
        <div class="code-panel-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="code-panel-title">docker · quick start</span>
        </div>
        <pre><span class="c"># 1. clone and run the interactive setup wizard</span>
docker compose run --rm telemeetbot \
  telemeetbot --wizard --config /data/telemeetbot.yml

<span class="c"># 2. start the background service</span>
docker compose up -d

<span class="c"># 3. prove health and active session capacity</span>
curl -s http://127.0.0.1:18080/healthz</pre>
        <div class="code-panel-foot">
          <span>{'{"status":"ok", "active_sessions":0, …}'}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Modern Spec Strip -->
  <section class="wrap" style="padding-top:24px">
    <div class="spec-strip" data-animate="specs">
      <div class="spec-cell">
        <span class="k">RUNTIME ENGINE</span>
        <span class="v">100% Go</span>
        <span class="d">Single static binary, zero runtime dependencies outside Chromium.</span>
      </div>
      <div class="spec-cell">
        <span class="k">DISPLAY OVERHEAD</span>
        <span class="v">0 MB</span>
        <span class="d">Headless tab capture over CDP — zero Xvfb, X11 or Wayland servers.</span>
      </div>
      <div class="spec-cell">
        <span class="k">DOCKER FOOTPRINT</span>
        <span class="v">~120 MB</span>
        <span class="d">Multi-arch Alpine base with pre-baked Chromium and fonts.</span>
      </div>
      <div class="spec-cell">
        <span class="k">ACTIVE RAM FOOTPRINT</span>
        <span class="v">180 - 240 MB</span>
        <span class="d">Measured memory consumption under an active 720p 30fps tab stream.</span>
      </div>
    </div>
  </section>

  <!-- Live Demo Teaser Section -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow"><Icon name="play" size={13} /> Telegram dashboard</span>
        <h2>Drive the meeting from your phone</h2>
        <p>
          Every control is an inline button on a live session card that refreshes every 3 seconds.
          Pause, mute, seek, restart and monitor telemetry without leaving Telegram.
        </p>
      </div>

      <div class="split" style="align-items:center">
        <div>
          <div class="terminal" aria-label="Telegram session card preview">
            <div class="terminal-bar">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <span style="margin-left:6px">Telegram · live card preview</span>
            </div>
            <div class="terminal-body"><span class="g">🟢</span> <b>Session s-4f2a1c9b</b>
<span class="m">🎞 Media:</span> Big Buck Bunny — Blender Foundation
<span class="m">🔗 Meet:</span> https://meet.google.com/abc-defg-hij
<span class="m">⏱ Playback:</span> 04:12 / 10:34
<span class="m">🔊 Volume:</span> 80%
<span class="m">📶 State:</span> <span class="g">streaming</span> — [6/6] Streaming live
<span class="m">⏳ Elapsed:</span> 6m

<span class="y">[⏸ Pause]</span>  <span class="y">[🔇 Mute]</span>
<span class="y">[⏪ -10s]</span>  <span class="y">[⏩ +10s]</span>
<span class="y">[🔉 Vol-]</span>  <span class="y">[🔊 Vol+]</span>
<span class="y">[♻️ Restart]</span> <span class="y">[⏹ Stop]</span></div>
          </div>
          <p class="muted" style="font-size:12.5px;margin:12px 0 0">
            Card fields and button labels are generated directly by <code class="mono">internal/bot/views.go</code>.
          </p>
        </div>

        <div class="card" style="padding:28px">
          <span class="eyebrow" style="color:var(--accent)">Try it in your browser</span>
          <h3 style="font-size:1.45rem;margin:8px 0 12px">Interactive session simulator</h3>
          <p>
            Experience the real button layout, playback timeline, guest admission and presentation
            surface in our client-side simulator before setting up your own bot.
          </p>
          <div style="margin-top:20px;display:flex;gap:12px;flex-wrap:wrap">
            <a class="btn btn-primary" href={url('/demo/')}>Open live demo <Icon name="arrowRight" size={16} /></a>
            <a class="btn btn-ghost" href={url('/docs/telegram/')}>Button reference</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="section" id="features">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What it does</span>
        <h2>A streaming bot that behaves like a careful operator</h2>
        <p>
          Built around three facts: Meet only shares what a real tab contains, headless Chromium needs
          specific capture flags, and a bot that cannot explain a failure is useless.
        </p>
      </div>
      <div class="grid-3">
        {features.map((feature) => (
          <article class="card">
            <span class="card-icon"><Icon name={feature.icon} size={19} /></span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
            <a class="card-link" href={url(feature.href)}>{feature.link} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CLI Flag & Configuration Explorer -->
  <section class="section" id="flags">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow"><Icon name="terminal" size={13} /> Engine configuration</span>
        <h2>Every flag is documented and verified</h2>
        <p>
          TeleMeetBot is configured via command-line flags or a YAML file. Select any flag below to
          inspect its type, default value, environment variable alias and operational notes.
        </p>
      </div>

      <div class="cli-window">
        <div class="cli-head">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="cli-title">telemeetbot --help · flags inspector</span>
        </div>
        <div class="cli-body">
          <div class="cli-list">
            {flags.map((f, i) => (
              <button
                class="cli-flag"
                type="button"
                data-flag-btn
                data-flag-name={f.flag}
                data-flag-type={f.type}
                data-flag-default={f.defaultVal || '(none)'}
                data-flag-env={f.env}
                data-flag-desc={f.description}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <span>{f.flag}</span>
              </button>
            ))}
          </div>
          <div class="cli-detail" data-flag-detail>
            <span class="flag-name">{flags[0].flag}</span>
            <span class="flag-type">{flags[0].type}</span>
            <p class="flag-desc">{flags[0].description}</p>
            <div class="flag-meta">
              <span>DEFAULT: <code>{flags[0].defaultVal || '(none)'}</code></span>
              <span>ENV: <code>{flags[0].env}</code></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Telegram Command Reference -->
  <section class="section" id="commands">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Telegram surface</span>
        <h2>Nine commands, one live card per session</h2>
        <p>
          Every command is authorised against the numeric allow-list before it is parsed. Strangers get
          their own id back and nothing else.
        </p>
      </div>

      <div class="split">
        <div class="terminal">
          <div class="terminal-bar">/help · trimmed</div>
          <div class="terminal-body"><span class="g">ℹ️ How TeleMeetBot works</span>

1. Open <b>New stream</b>.
2. Send a Google Meet link (meet.google.com/abc-defg-hij).
3. Send the media link (YouTube, mp4/webm/mp3, or a page).
4. Confirm — the bot opens Meet as a guest,
   shares a tab and plays it.</div>
        </div>
        <div class="prose" style="margin:0">
          <table>
            <thead><tr><th>Command</th><th>What it does</th></tr></thead>
            <tbody>
              {repo.commands.map((command) => (
                <tr>
                  <td><code class="mono">{command.command}</code></td>
                  <td>{command.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p style="margin-top:12px"><a href={url('/docs/telegram/')}>Full command and button reference →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Diagnostics Section -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">When it breaks</span>
        <h2>Diagnostics that answer the question</h2>
        <p>
          Meet changes its UI; YouTube changes its consent wall; servers run out of shared memory.
          Each failure has a probe that reproduces it without a meeting.
        </p>
      </div>

      <div class="split">
        <div class="terminal">
          <div class="terminal-bar">doctor + capture self-test</div>
          <div class="terminal-body"><span class="b">$</span> telemeetbot --config telemeetbot.yml --check --capture-test

<span class="g">✅</span> config            valid (telemeetbot.yml)
<span class="g">✅</span> telegram token    @YourBot
<span class="g">✅</span> chromium          /usr/bin/chromium &lt;version&gt;
<span class="g">✅</span> disk              42.1 GB free of 78.0 GB
<span class="g">✅</span> health port       127.0.0.1:18080 is free
<span class="g">✅</span> network           google.com reachable
<span class="g">✅</span> tab capture       granted video=true audio=true
                       frames_changed=4 label=TeleMeet Media</div>
        </div>
        <div>
          <ul class="feature-list">
            <li>
              <Icon name="check" size={17} />
              <span><strong>Media probe.</strong>
              <code class="mono">--media-probe &lt;url&gt;</code> plays a link in the same player the bot
              uses and reports readyState, position advance, mean RGB, green/black frames, consent
              state and the verdict — no meeting required.</span>
            </li>
            <li>
              <Icon name="check" size={17} />
              <span><strong>Meeting probe.</strong>
              <code class="mono">--probe &lt;meet-url&gt;</code> joins with the real engine, streams the
              stage sequence, and exits without touching Telegram.</span>
            </li>
            <li>
              <Icon name="check" size={17} />
              <span><strong>Health JSON.</strong>
              <code class="mono">/healthz</code> reports version, Go build, uptime, active and maximum
              sessions, Chromium path, free disk and the config path.</span>
            </li>
          </ul>
          <a class="btn btn-ghost btn-sm" href={url('/docs/diagnostics/')} style="margin-top:20px">
            Diagnostics reference <Icon name="arrowRight" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Modern CTA Band -->
  <section class="section section-last">
    <div class="wrap">
      <div class="cta-band">
        <span class="eyebrow"><Icon name="spark" size={13} /> Start streaming today</span>
        <h2 style="font-size:clamp(1.7rem,3.6vw,2.4rem);letter-spacing:-.03em;margin:10px 0 0">
          Ten minutes from clone to first stream
        </h2>
        <p class="muted" style="margin-top:12px;max-width:58ch">
          Create a bot with @BotFather, claim it with <code class="mono">/start</code>, send a Meet
          link and a media link. The wizard handles the config; the doctor proves the capture path
          before you need it in a real call.
        </p>
        <div class="hero-cta" style="margin-top:22px">
          <a class="btn btn-primary" href={url('/docs/getting-started/')}>Install TeleMeetBot</a>
          <a class="btn btn-ghost" href={releaseUrl} rel="noopener">Release {version}</a>
          <a class="btn btn-ghost" href={url('/compare/')}>Compare with alternatives</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
