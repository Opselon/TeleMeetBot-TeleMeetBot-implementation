---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import repo from '../../data/repo.generated.json';
import { absolute, url } from '../../utils/paths';

const entries = (await getCollection('releases')).sort((a, b) => {
  const da = a.data.publishedAt ? Date.parse(a.data.publishedAt) : 0;
  const db = b.data.publishedAt ? Date.parse(b.data.publishedAt) : 0;
  return db - da || a.data.tag.localeCompare(b.data.tag);
});
const latest = repo.github.releases.find((release) => !release.draft && !release.prerelease) ?? repo.github.releases[0];
const assets = latest?.assets ?? [];
const fmtDate = (value: string | null) =>
  value ? new Date(value).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) : 'unreleased';
const kb = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'TeleMeetBot releases',
    description: 'Release notes and downloadable archives for TeleMeetBot.',
    url: absolute('/releases/'),
  },
];
---
<BaseLayout title="Releases — TeleMeetBot" description="TeleMeetBot release notes, download archives for every supported Linux architecture, and checksums." jsonLd={jsonLd}>
  <div class="wrap" style="max-width:1000px;padding-block:52px 20px">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={url('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Releases</span>
    </nav>
    <span class="eyebrow">Releases</span>
    <h1 class="docs-title" style="margin-top:10px">Release notes</h1>
    <p class="docs-lede" style="max-width:62ch">
      Tagged releases, what changed, and the archives published with each one. Versions follow
      semantic versioning; the latest tag is <strong>{repo.version}</strong>.
    </p>
    <div class="docs-meta">
      <span class="chip chip-accent">{repo.version}</span>
      <span class="chip">{entries.length} notes</span>
      <span class="chip">{repo.releaseTargets.length} architectures</span>
      <span class="chip">{repo.github.source === 'api' ? 'live from GitHub' : 'snapshot'}</span>
    </div>
  </div>

  <div class="wrap split" style="max-width:1000px;padding-bottom:72px;align-items:start">
    <div>
      {entries.map((entry) => (
        <article class="card" style="margin-bottom:14px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="chip chip-accent">{entry.data.tag}</span>
            <span class="mono" style="font-size:11.5px;color:var(--faint)">{fmtDate(entry.data.publishedAt)}</span>
            {!entry.data.publishedAt && <span class="chip">Unreleased</span>}
          </div>
          <h2 style="margin:4px 0 0;font-size:1.15rem">{entry.data.title}</h2>
          <p>{entry.data.summary}</p>
          <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:6px">
            <a class="card-link" href={url(`/releases/${entry.data.tag}/`)}>Read the notes →</a>
            {entry.data.releaseUrl && (
              <a class="card-link" href={entry.data.releaseUrl} rel="noopener">GitHub release ↗</a>
            )}
          </div>
        </article>
      ))}
      {entries.length === 0 && <p class="muted">No release notes found in the repository.</p>}
    </div>

    <aside>
      <div class="card">
        <span class="eyebrow" style="color:var(--accent-2)">Latest download</span>
        <h3 style="margin:6px 0 0">{latest ? latest.tag : repo.version}</h3>
        {latest ? (
          <>
            <p class="mono" style="font-size:11.5px;color:var(--faint)">published {fmtDate(latest.publishedAt)}</p>
            <table style="width:100%;font-size:12.5px;border-collapse:collapse">
              <tbody>
                {assets.map((asset) => (
                  <tr>
                    <td style="padding:6px 0"><a href={asset.url}>{asset.name.replace('telemeetbot-', '').replace('.tar.gz', '')}</a></td>
                    <td style="padding:6px 0;text-align:right;color:var(--faint)">{kb(asset.size)}</td>
                    <td style="padding:6px 0;text-align:right;color:var(--faint)">{asset.downloads} ↓</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <a class="btn btn-ghost btn-sm" href={latest.url} rel="noopener" style="margin-top:12px">
              <Icon name="github" size={15} /> View on GitHub
            </a>
          </>
        ) : (
          <p>No published release metadata available.</p>
        )}
      </div>

      <div class="card" style="margin-top:14px">
        <h3>Install the latest</h3>
        <pre style="margin:8px 0 0;padding:12px;border:1px solid var(--code-border);border-radius:9px;background:var(--code-bg);white-space:pre-wrap;overflow-wrap:anywhere"><code class="mono" style="font-size:11.5px;color:#dbe7f5">curl -fsSL https://raw.githubusercontent.com/{repo.repoSlug}/main/scripts/install.sh | sudo bash</code></pre>
        <p style="font-size:12.5px">Verifies the archive against <code>SHA256SUMS</code> before installing.</p>
      </div>
    </aside>
  </div>
</BaseLayout>
