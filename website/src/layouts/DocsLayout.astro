---
import BaseLayout from './BaseLayout.astro';
import DocsNav from '../components/DocsNav.astro';
import Icon from '../components/Icon.astro';
import { docPath, getDocs, neighbours, type Doc } from '../lib/docs';
import { absolute, url } from '../utils/paths';

type Props = {
  doc: Doc;
  headings: { depth: number; slug: string; text: string }[];
};

const { doc, headings } = Astro.props;
const docs = await getDocs();
const { prev, next } = neighbours(docs, doc);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const canonical = absolute(docPath(doc));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: doc.data.title,
    description: doc.data.description,
    url: canonical,
    mainEntityOfPage: canonical,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'TeleMeetBot', url: absolute('/') },
    publisher: { '@type': 'Organization', name: 'Opselon', url: 'https://github.com/Opselon' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: 'Documentation', item: absolute('/docs/') },
      { '@type': 'ListItem', position: 3, name: doc.data.title, item: canonical },
    ],
  },
];
---
<BaseLayout title={`${doc.data.title} — TeleMeetBot docs`} description={doc.data.description} type="article" jsonLd={jsonLd}>
  <div class="docs-shell">
    <DocsNav docs={docs} currentId={doc.id} />

    <div>
      <div class="docs-mobile-bar">
        <button class="icon-btn" type="button" data-drawer-open aria-controls="docs-drawer" aria-expanded="false" aria-label="Open documentation menu">
          <Icon name="menu" size={18} />
        </button>
        <span class="mono" style="font-size:12px;color:var(--faint)">{doc.data.group}</span>
        <span class="mono" style="margin-left:auto;font-size:11px;color:var(--faint)">{doc.data.title}</span>
      </div>

      <div class="docs-main">
        <article class="docs-article">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href={url('/')}>Home</a>
            <span aria-hidden="true">/</span>
            <a href={url('/docs/')}>Docs</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{doc.data.title}</span>
          </nav>

          <h1 class="docs-title">{doc.data.title}</h1>
          <p class="docs-lede">{doc.data.description}</p>
          <div class="docs-meta">
            <span class="chip">{doc.data.group}</span>
            <span class="chip">Updated from <span class="mono">main</span></span>
            {doc.data.keywords.slice(0, 3).map((keyword) => <span class="chip">{keyword}</span>)}
          </div>

          <div class="docs-body prose">
            <slot />
          </div>

          <nav class="docs-pager" aria-label="Documentation pagination">
            {prev ? (
              <a class="pager-link" href={url(docPath(prev))}>
                <span>← Previous</span>
                <strong>{prev.data.title}</strong>
              </a>
            ) : <span></span>}
            {next ? (
              <a class="pager-link pager-next" href={url(docPath(next))}>
                <span>Next →</span>
                <strong>{next.data.title}</strong>
              </a>
            ) : <span></span>}
          </nav>

          <p class="docs-edit">
            Found something wrong? <a href={`https://github.com/Opselon/TeleMeetBot-TeleMeetBot-implementation/issues/new`} rel="noopener">Open an issue</a>
            or edit <a href={`https://github.com/Opselon/TeleMeetBot-TeleMeetBot-implementation/blob/main/website/src/content/docs/${doc.id}.md`} rel="noopener">this page on GitHub</a>.
          </p>
        </article>
      </div>
    </div>

    <aside class="docs-toc" aria-label="On this page">
      <div class="docs-toc-inner" data-toc>
        <h2>On this page</h2>
        <ul>
          {toc.map((heading) => (
            <li class={`depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
        <p style="margin-top:22px">
          <a class="chip" href={`https://github.com/Opselon/TeleMeetBot-TeleMeetBot-implementation`} rel="noopener">Source on GitHub</a>
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
